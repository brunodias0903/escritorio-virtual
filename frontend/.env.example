# Copie para .env e preencha apenas se quiser apontar para um servidor fora do padrão.
# O .env não vai para o Git.

# Endereço da API HTTP (sem barra no final).
# Em desenvolvimento, vazio aponta para http://<host-da-pagina>:5001.
# Em produção (atrás do nginx), vazio usa a mesma origem da página (/api).
VITE_API_URL=

# Endereço do WebSocket em tempo real.
# Em desenvolvimento, vazio aponta para ws://<host-da-pagina>:5001.
# Em produção (atrás do nginx), vazio usa a mesma origem da página em /ws.
VITE_WS_URL=
