# Copie para .env ou rode `pnpm env:init` (gera as senhas automaticamente).
# O .env não vai para o Git.

# --- Perfis opcionais do Docker Compose ---------------------------------------
# Vazio = uso local (Postgres, Valkey, LiveKit, servidor e frontend web).
# dev   = adiciona Mailpit para testar códigos de e-mail em http://localhost:5007.
# prod  = adiciona Caddy (HTTPS automático) e backup diário do PostgreSQL (VPS).
COMPOSE_PROFILES=

# --- Acesso web (local no Mac e Windows WSL2) ---------------------------------
# Padrão 5080 evita conflito com o AirPlay Receiver do macOS (que ocupa a 5000).
WEB_BIND=127.0.0.1
WEB_PORT=5080

# --- Proxy reverso HTTPS (apenas VPS com COMPOSE_PROFILES=prod) ---------------
# Domínio apontado para o IP da VPS (ex.: escritorio.seudominio.com).
SITE_DOMAIN=localhost

# --- Portas de debug do servidor (mantidas em 127.0.0.1 por segurança) --------
SERVER_BIND=127.0.0.1
PORT=5001

# --- Banco e cache (use só letras e números: entram em URLs) ------------------
POSTGRES_PASSWORD=
VALKEY_PASSWORD=

# --- Sessões: 32 caracteres ou mais (ex.: openssl rand -hex 32) ---------------
SESSION_SECRET=

# --- Quem pode criar conta (defina ao menos ACCOUNT_DOMAINS ou ALLOWED_EMAILS) -
# Domínios inteiros separados por vírgula. ":externo" marca convidado.
ACCOUNT_DOMAINS=gmail.com,outlook.com,outlook.com.br,hotmail.com,live.com,icloud.com,me.com,proton.me,protonmail.com,yahoo.com,yahoo.com.br
# E-mails avulsos separados por vírgula. Ex.: ana@empresa.com,bia@empresa.com
ALLOWED_EMAILS=
# Administradores (array JSON ou separados por vírgula; precisam estar liberados acima).
# Para adicionar mais adms: ADMIN_EMAILS=["bdd.vasconcelos@gmail.com","outro@outlook.com"]
ADMIN_EMAILS=["bdd.vasconcelos@gmail.com"]

# --- Origens autorizadas (CORS e WebSocket) -----------------------------------
# Local: http://localhost:5080
# VPS:   https://escritorio.seudominio.com
# Aceita curinga de subdomínio, ex.: https://*.trycloudflare.com
ALLOWED_ORIGINS=http://localhost:5080

# Atrás do nginx do frontend (e do Caddy na VPS): true lê X-Forwarded-For.
TRUST_PROXY=true

# --- E-mail com código de confirmação -----------------------------------------
# Desligado por padrão no cadastro (false).
# Para enviar e-mails reais pelo Gmail gratuitamente (usando Senha de App do Google):
#   EMAIL_CODES=true
#   SMTP_HOST=smtp.gmail.com
#   SMTP_PORT=587
#   SMTP_SECURE=false
#   SMTP_USER=bdd.vasconcelos@gmail.com
#   SMTP_PASS=<sua-senha-de-app-de-16-caracteres-do-google>
#   SMTP_FROM=Escritório Virtual <bdd.vasconcelos@gmail.com>
# Para testar com Mailpit local: COMPOSE_PROFILES=dev, SMTP_HOST=mailpit, SMTP_PORT=1025.
EMAIL_CODES=false
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=bdd.vasconcelos@gmail.com
SMTP_PASS=
SMTP_FROM=Escritório Virtual <bdd.vasconcelos@gmail.com>

# --- Voz e vídeo (LiveKit) ----------------------------------------------------
LIVEKIT_API_KEY=escritorio
LIVEKIT_API_SECRET=
# IP visto pelo navegador para mídia WebRTC:
#   Local (Mac / Windows WSL2): 127.0.0.1
#   VPS (produção):             IP público da VPS (curl -fsS https://api.ipify.org)
LIVEKIT_NODE_IP=127.0.0.1
# Endereço de sinalização que o navegador usa:
#   Local (Mac / Windows WSL2): ws://localhost:5080/livekit
#   VPS (produção):             wss://escritorio.seudominio.com/livekit
LIVEKIT_PUBLIC_URL=ws://localhost:5080/livekit
