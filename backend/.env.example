# Copie para .env e preencha. O .env não vai para o Git.

# Endereço e porta do servidor HTTP + WebSocket.
HOST=0.0.0.0
PORT=5001
# Em Docker (docker-compose.yml): 127.0.0.1 para ficar atrás de nginx/Caddy local,
# ou 0.0.0.0 para expor na rede.
SERVER_BIND=127.0.0.1

# Banco e cache. Use só letras e números nas senhas (elas entram em URLs).
POSTGRES_PASSWORD=
VALKEY_PASSWORD=
# Opcional ao rodar direto no host (no docker-compose.yml é montada sozinha).
# DATABASE_URL=postgres://virtual_office:devpass123@127.0.0.1:5004/virtual_office
# REDIS_URL=redis://:devvalkey123@127.0.0.1:5005

# Sessões: 32 caracteres ou mais. Ex.: openssl rand -hex 32
SESSION_SECRET=

# Quem pode criar conta. Defina pelo menos um dos dois.
# Domínios inteiros, separados por vírgula. ":externo" = convidado (nunca admin).
ACCOUNT_DOMAINS=gmail.com,outlook.com,outlook.com.br,hotmail.com,live.com,icloud.com,me.com,proton.me,protonmail.com,yahoo.com,yahoo.com.br
# E-mails soltos, separados por vírgula. Ex.: ana@empresa.com,bia@empresa.com
ALLOWED_EMAILS=

# Administradores (array JSON ou separados por vírgula; precisam estar liberados acima).
# Para adicionar mais adms: ADMIN_EMAILS=["bdd.vasconcelos@gmail.com","outro@outlook.com"]
ADMIN_EMAILS=["bdd.vasconcelos@gmail.com"]

# Origens autorizadas (CORS e WebSocket), separadas por vírgula.
# Ex.: http://localhost:5000 ou https://virtual-office.exemplo.com
ALLOWED_ORIGINS=

# Atrás de proxy reverso (nginx / Caddy): true lê o IP real de X-Forwarded-For.
TRUST_PROXY=false

# Código por e-mail (criar conta e esqueci a senha). Desligado: false.
# Para ligar: EMAIL_CODES=true e preencha o SMTP abaixo.
EMAIL_CODES=false
# Porta 587 com SMTP_SECURE=false (STARTTLS) ou 465 com SMTP_SECURE=true.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=Escritório Virtual <nao-responda@exemplo.com>

# Voz e vídeo (LiveKit). Chave e segredo: qualquer texto; o segredo com 32+ caracteres.
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
# IP do servidor visto por quem usa o app (a mídia WebRTC vai direto a ele).
LIVEKIT_NODE_IP=
# Endereço que o navegador/app usa, ex.: wss://virtual-office.exemplo.com/livekit
LIVEKIT_PUBLIC_URL=
# Opcional ao rodar direto no host (no docker-compose.yml usa LIVEKIT_PUBLIC_URL).
# LIVEKIT_URL=ws://localhost:5002
